datasource db {
  provider = "sqlite" // Or "postgresql" depending on your configuration
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Question {
  id         String   @id @default(uuid())
  title      String
  content    String
  tags       String   @default("general")
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  answers    Answer[]
}

model Answer {
  id         String   @id @default(uuid())
  content    String
  isApproved Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model TeacherReview {
  id          String   @id @default(uuid())
  teacherName String
  courseCode  String
  rating      Int
  gradingEase Int
  reviewText  String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}